#!/usr/bin/env python3
"""bible -- fetch ESV or NET Bible passages from the command line.

Usage:
  bible luke 2:1-5
  bible psalm 29:1-10
  bible psalm 150
  bible John 3:16
  bible -t net John 3:16

The ESV (the default) requires a free API key from https://api.esv.org/
in the ESV_API_KEY environment variable. The NET Bible needs no key.
"""

import argparse
import hashlib
import html
import json
import os
import re
import shutil
import sys
import textwrap
import urllib.error
import urllib.parse
import urllib.request

API_URL = "https://api.esv.org/v3/passage/text/"
NET_API_URL = "https://labs.bible.org/api/"
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "bible"
)


# (book, chapters) in canonical order, using names both APIs accept.
OLD_TESTAMENT = [
    ("Genesis", 50), ("Exodus", 40), ("Leviticus", 27), ("Numbers", 36),
    ("Deuteronomy", 34), ("Joshua", 24), ("Judges", 21), ("Ruth", 4),
    ("1 Samuel", 31), ("2 Samuel", 24), ("1 Kings", 22), ("2 Kings", 25),
    ("1 Chronicles", 29), ("2 Chronicles", 36), ("Ezra", 10), ("Nehemiah", 13),
    ("Esther", 10), ("Job", 42), ("Psalms", 150), ("Proverbs", 31),
    ("Ecclesiastes", 12), ("Song of Solomon", 8), ("Isaiah", 66), ("Jeremiah", 52),
    ("Lamentations", 5), ("Ezekiel", 48), ("Daniel", 12), ("Hosea", 14),
    ("Joel", 3), ("Amos", 9), ("Obadiah", 1), ("Jonah", 4), ("Micah", 7),
    ("Nahum", 3), ("Habakkuk", 3), ("Zephaniah", 3), ("Haggai", 2),
    ("Zechariah", 14), ("Malachi", 4),
]
NEW_TESTAMENT = [
    ("Matthew", 28), ("Mark", 16), ("Luke", 24), ("John", 21), ("Acts", 28),
    ("Romans", 16), ("1 Corinthians", 16), ("2 Corinthians", 13), ("Galatians", 6),
    ("Ephesians", 6), ("Philippians", 4), ("Colossians", 4), ("1 Thessalonians", 5),
    ("2 Thessalonians", 3), ("1 Timothy", 6), ("2 Timothy", 4), ("Titus", 3),
    ("Philemon", 1), ("Hebrews", 13), ("James", 5), ("1 Peter", 5), ("2 Peter", 3),
    ("1 John", 5), ("2 John", 1), ("3 John", 1), ("Jude", 1), ("Revelation", 22),
]


def die(msg, code=1):
    print(f"bible: {msg}", file=sys.stderr)
    sys.exit(code)


def get_api_key():
    key = (os.environ.get("ESV_API_KEY") or "").strip()
    if not key:
        die(
            "no API key found.\n"
            "  1. Get a free key at https://api.esv.org/ (Account > Create API Application)\n"
            "  2. export ESV_API_KEY=your-key-here   (add to ~/.bashrc to persist)"
        )
    return key


def target_width(explicit):
    if explicit is not None:
        return max(explicit, 20)
    cols = shutil.get_terminal_size((80, 24)).columns
    return min(max(cols, 40), 80)


def build_params(query, args):
    return {
        "q": query,
        "include-passage-references": "true",
        "include-verse-numbers": "false" if args.no_verse_numbers else "true",
        "include-first-verse-numbers": "true",
        "include-footnotes": "true" if args.footnotes else "false",
        "include-footnote-body": "true" if args.footnotes else "false",
        "include-headings": "false" if args.no_headings else "true",
        "include-short-copyright": "false" if args.no_copyright else "true",
        "include-passage-horizontal-lines": "false",
        "include-heading-horizontal-lines": "false",
        "line-length": str(target_width(args.width)),
    }


def cache_path(params):
    blob = json.dumps(params, sort_keys=True).encode()
    return os.path.join(CACHE_DIR, hashlib.sha256(blob).hexdigest()[:16] + ".json")


def fetch(url, params, headers=None, use_cache=True, missing=()):
    path = cache_path(params)
    if use_cache and os.path.exists(path):
        try:
            with open(path) as fh:
                return json.load(fh)
        except (OSError, ValueError):
            pass

    req = urllib.request.Request(url + "?" + urllib.parse.urlencode(params), headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read()
    except urllib.error.HTTPError as exc:
        if exc.code in missing:
            return None
        if exc.code == 401:
            die("API key rejected (HTTP 401). Check ESV_API_KEY.")
        detail = exc.read().decode(errors="replace").strip()[:300]
        die(f"{urllib.parse.urlsplit(url).netloc} returned HTTP {exc.code}. {detail}")
    except urllib.error.URLError as exc:
        die(f"network error: {exc.reason}")

    # The NET API answers an unknown reference with an empty body (or a 400).
    if not body.strip():
        return None
    try:
        data = json.loads(body)
    except ValueError:
        die(f"unexpected response from {urllib.parse.urlsplit(url).netloc}")

    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path, "w") as fh:
            json.dump(data, fh)
    except OSError:
        pass
    return data


def net_reference(verses):
    first, last = verses[0], verses[-1]
    start = f"{first['bookname']} {first['chapter']}:{first['verse']}"
    if first is last:
        return start
    if last["bookname"] != first["bookname"]:
        return f"{start}–{last['bookname']} {last['chapter']}:{last['verse']}"
    if last["chapter"] != first["chapter"]:
        return f"{start}–{last['chapter']}:{last['verse']}"
    return f"{start}–{last['verse']}"


def format_net(verses, args):
    """Lay out a NET passage like the ESV API's text output.

    With formatting=para each <p class="bodytext|poetry"> starts a new
    paragraph (poetry: one per line); text before any <p> continues the
    current one.
    """
    paras = []  # [style, [text pieces]]
    for v in verses:
        prefix = "" if args.no_verse_numbers else f"[{v['verse']}] "
        for tok in re.split(r"(<[^>]+>)", v["text"]):
            m = re.match(r"<p\b(?:[^>]*\bclass=\"(\w+)\")?[^>]*>", tok)
            if m:
                paras.append([m.group(1) or "bodytext", []])
            elif tok.startswith("</p"):
                paras.append(["bodytext", []])
            elif not tok.startswith("<") and tok.strip():
                if not paras:
                    paras.append(["bodytext", []])
                paras[-1][1].append(prefix + tok)
                prefix = ""

    lines = []
    for style, pieces in paras:
        text = re.sub(r"\s+", " ", html.unescape(" ".join(pieces))).strip()
        if text:
            lines.append([style, text])
    if not args.no_copyright and lines:
        lines[-1][1] += " (NET)"

    width = target_width(args.width)
    out = [net_reference(verses), ""]
    for style, text in lines:
        if style == "poetry":
            out.append(textwrap.fill(text, width, initial_indent="    ", subsequent_indent="        "))
        else:
            out.append(textwrap.fill(text, width, initial_indent="  "))
    return "\n".join(out)


def run_net(query, args):
    if args.footnotes:
        die("the NET Bible API doesn't provide its translators' notes; drop --footnotes")
    results = []
    for ref in (r.strip() for r in query.split(";")):
        if ref:
            params = {"passage": ref, "type": "json", "formatting": "para"}
            data = fetch(NET_API_URL, params, use_cache=not args.no_cache, missing=(400,))
            if not data and not args.raw:
                print(f"bible: no passage found for {ref!r}", file=sys.stderr)
            results.append(data or [])

    if args.raw:
        json.dump(results, sys.stdout, indent=2)
        print()
        return
    if not any(results):
        sys.exit(1)
    print("\n\n".join(format_net(verses, args) for verses in results if verses))


def format_books(title, books, width):
    """List books with chapter counts in columns, filled top to bottom."""
    name_w = max(len(name) for name, _ in books)
    num_w = max(len(str(n)) for _, n in books)
    cell_w = name_w + 1 + num_w
    gap = 4
    cols = max(1, (width - 2 + gap) // (cell_w + gap))
    rows = -(-len(books) // cols)
    out = [f"{title} ({len(books)} books, chapters shown)", ""]
    for r in range(rows):
        cells = [
            f"{name:<{name_w}} {n:>{num_w}}"
            for name, n in books[r::rows]
        ]
        out.append("  " + (" " * gap).join(cells))
    return "\n".join(out)


def run_books(which, args):
    width = target_width(args.width)
    sections = []
    if which in ("ot", "all"):
        sections.append(format_books("Old Testament", OLD_TESTAMENT, width))
    if which in ("nt", "all"):
        sections.append(format_books("New Testament", NEW_TESTAMENT, width))
    print("\n\n".join(sections))


def main():
    parser = argparse.ArgumentParser(
        prog="bible",
        description="Fetch ESV or NET Bible passages from the command line.",
        epilog=(
            "examples:\n"
            "  bible luke 2:1-5\n"
            "  bible psalm 29:1-10\n"
            "  bible psalm 150\n"
            "  bible 'John 3:16; Romans 8:28'\n"
            "  bible -t net John 3:16\n"
            "  bible --books nt\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("reference", nargs="*", help="passage, e.g. luke 2:1-5")
    parser.add_argument(
        "--books", nargs="?", const="all", choices=["ot", "nt", "all"],
        help="list the books of the Old (ot) or New (nt) Testament, or both",
    )
    parser.add_argument(
        "-t", "--translation", choices=["esv", "net"], default="esv",
        help="translation to fetch (default: esv)",
    )
    parser.add_argument("--no-verse-numbers", action="store_true", help="hide verse numbers")
    parser.add_argument(
        "--no-headings", action="store_true", help="hide section headings (ESV only)"
    )
    parser.add_argument("--footnotes", action="store_true", help="include footnotes (ESV only)")
    parser.add_argument(
        "--no-copyright", action="store_true", help="hide the trailing '(ESV)'/'(NET)' tag"
    )
    parser.add_argument(
        "--width", type=int, metavar="N",
        help="wrap at N columns (default: terminal width, capped at 80)",
    )
    parser.add_argument("--no-cache", action="store_true", help="bypass the local cache")
    parser.add_argument("--raw", action="store_true", help="print the raw JSON response")
    args = parser.parse_args()

    if args.books:
        run_books(args.books, args)
        return
    if not args.reference:
        parser.error("the following arguments are required: reference")

    query = " ".join(args.reference).strip()
    if args.translation == "net":
        run_net(query, args)
        return

    key = get_api_key()
    params = build_params(query, args)
    data = fetch(API_URL, params, {"Authorization": f"Token {key}"}, use_cache=not args.no_cache)
    if data is None:
        die(f"no passage found for {query!r}")

    if args.raw:
        json.dump(data, sys.stdout, indent=2)
        print()
        return

    passages = data.get("passages") or []
    if not passages:
        die(f"no passage found for {query!r}")
    print("\n\n".join(p.strip() for p in passages).strip())


if __name__ == "__main__":
    main()
